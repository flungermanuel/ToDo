{
  "name": "flungdo",
  "productName": "FlungDo",
  "version": "1.2.0",
  "description": "FlungDo – cleane Desktop-App für Todos und Deadlines",
  "author": "Manuel Flunger",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
